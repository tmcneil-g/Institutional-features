# Logistic regression for presence of undergraduate data science major

library("stats")
library(car)

# Read data
institutional_data <- read.csv(file = "data/institutional_data_1.csv")

# Center continuous independent variables and add as new variables
institutional_data$average_salary_c <- 
          scale(institutional_data$average_salary, 
          center = TRUE, scale = FALSE)
institutional_data$fte_staff_c <- 
          scale(institutional_data$fte_staff, 
          center = TRUE, scale = FALSE)
institutional_data$endowment_c <- 
          scale(institutional_data$endowment, 
          center = TRUE, scale = FALSE)
institutional_data$core_expenses_c <- 
          scale(institutional_data$core_expenses, 
          center = TRUE, scale = FALSE)
institutional_data$ endowment_per_fte_c <- 
          scale(institutional_data$endowment_per_fte , 
          center = TRUE, scale = FALSE)

# Run logistic regression
model_all <- glm(ds_program ~ liberal_arts + r1 + r2 + barron_rank + public_private +
          size + land_grant + access_earnings + admitted + women + international + 
          white + hispanic + black + asian + undergrad_enrollment_ft + graduation +
          endowment_per_fte_c + equity_ratio + core_expenses_c + endowment_c + 
          fte_staff_c + average_salary_c, 
          data = institutional_data, 
          family = binomial)

vif(model_all)

summary(model_all)
exp(coef(model_all))
