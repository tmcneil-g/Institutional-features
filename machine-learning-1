# Read in data
institutional_data <- read.csv("C:/Users/ual-laptop/Desktop/institutional_data_1.csv")

# Convert variables in dataset into categorical (factor) variables
institutional_data$liberal_arts <- factor(institutional_data$liberal_arts)
institutional_data$r1 <- factor(institutional_data$r1)
institutional_data$r2 <- factor(institutional_data$r2)
institutional_data$ds_program <- factor(institutional_data$ds_program, labels=c("DS", "No_DS"))
institutional_data$public_private <- factor(institutional_data$public_private)
institutional_data$size <- factor(institutional_data$size)
institutional_data$land_grant <- factor(institutional_data$land_grant)
institutional_data$access_earnings <- factor(institutional_data$access_earnings)

# Center continuous independent variables and add as new variables
institutional_data$average_salary_c <- 
  scale(institutional_data$average_salary, 
        center = TRUE, scale = FALSE)
institutional_data$fte_staff_c <- 
  scale(institutional_data$fte_staff, 
        center = TRUE, scale = FALSE)
institutional_data$endowment_c <- 
  scale(institutional_data$endowment, 
        center = TRUE, scale = FALSE)
institutional_data$core_expenses_c <- 
  scale(institutional_data$core_expenses, 
        center = TRUE, scale = FALSE)
institutional_data$ endowment_per_fte_c <- 
  scale(institutional_data$endowment_per_fte , 
        center = TRUE, scale = FALSE)

# Split data
set.seed(1985)

# Create train and test indices
trainIndex <- createDataPartition(institutional_data$ds_program, p=0.2, list = FALSE, times = 1)

train <- institutional_data[trainIndex,]
test <- institutional_data[-trainIndex,]

#Set control parameters for model training
