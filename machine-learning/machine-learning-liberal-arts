library(caret)
library(parallel)
library(iml)
library(randomForest)
library(dplyr)
library(gbm)
library(quadprog)
library(nnet)
library(pROC)

# Convention to leave 1 core for OS
cl <- makeCluster(detectCores() - 1)

# Read in data
institutional_data <- read.csv(file = "data/institutional_data_all_la.csv")

# Convert variables in dataset into categorical (factor) variables
institutional_data$type <- factor(institutional_data$type)
institutional_data$ds_program <- factor(institutional_data$ds_program, 
                                        labels=c("DS", "No_DS"))
institutional_data$public_private <- factor(institutional_data$public_private)
institutional_data$barron_rank <- factor(institutional_data$barron_rank, 
                                         ordered = TRUE)

# Center and scale continuous independent variables
# Center and scale continuous independent variables
institutional_data$endowment <- scale(institutional_data$endowment, 
                                      center = TRUE, scale = TRUE)
institutional_data$admitted <- scale(institutional_data$admitted, 
                                     center = TRUE, scale = TRUE)
institutional_data$women <- scale(institutional_data$women, 
                                  center = TRUE, scale = TRUE)
institutional_data$international <- scale(institutional_data$international, 
                                          center = TRUE, scale = TRUE)
institutional_data$undergrad_enrollment_ft <- 
  scale(institutional_data$undergrad_enrollment_ft, 
        center = TRUE, scale = TRUE)
institutional_data$per_minority <- scale(institutional_data$per_minority, 
        center = TRUE, scale = TRUE)
institutional_data$fte_staff <- scale(institutional_data$fte_staff, 
                                       center = TRUE, scale = TRUE)
institutional_data$core_expenses <- scale(institutional_data$core_expenses, 
                                       center = TRUE, scale = TRUE)
institutional_data$endowment_per_fte <- 
  scale(institutional_data$endowment_per_fte, 
  center = TRUE, scale = TRUE)
institutional_data$endowment_per_fte <- 
  scale(institutional_data$endowment_per_fte, 
  center = TRUE, scale = TRUE)
institutional_data$usnews_rank <- 
  scale(institutional_data$usnews_rank, 
  center = TRUE, scale = TRUE)

# Split data
set.seed(1985)
trainIndex <- createDataPartition(institutional_data$ds_program, p=0.8, list = FALSE, times = 1)

# Remove columns
institutional_data <- institutional_data %>%
  select(-institution, -white, -hispanic, -black, -asian, -amindian, -pacific, 
  -two_races, -endowment_per_fte, -core_expenses, -barron_rank)

# Create train and test indices
train <- institutional_data[trainIndex,]
test <- institutional_data[-trainIndex,]

#Set control parameters for model training
fitCtrl <- trainControl(method = "repeatedcv",
                        number = 5,
                        repeats = 2,
                        summaryFunction=twoClassSummary,
                        ## Estimate class probabilities
                        classProbs = TRUE,
                        ## returnData = TRUE,
                        savePredictions = TRUE,
                        ## Search "grid" or "random"
                        search = "random",
                        ## Down-sampling
                        sampling = "down",
                        ## Use cluster
                        allowParallel = TRUE)

# Set testing grid for random forest
rfGrid <- expand.grid(mtry = 1:6)

# Random forest
rf.res <- train(ds_program ~ .,
                data=train,
                method="rf",
                trControl=fitCtrl,
                tuneGrid=rfGrid,
                metric="Accuracy",
                verbose=FALSE)

rf.res

# Extract predictions
confusionMatrix(predict(rf.res, train, type="raw"), train$ds_program)

confusionMatrix(predict(rf.res, test, type="raw"), test$ds_program)

# Variable importance
rfImp <- varImp(rf.res)
plot(rfImp)

# Gradient boosting machine
# Set control parameters for model training for gradient boosting machine
gbmGrid <-  expand.grid(n.trees = c(1:20)*100,
                        interaction.depth=c(2,3),
                        shrinkage = c(0.01, 0.05),
                        n.minobsinnode=c(5,10))

# Estimate gradient boosting machine model
set.seed(1985)
gbm.res <- train(ds_program ~ .,
    data=train,
    method="gbm",
    trControl=fitCtrl,
    tuneGrid=gbmGrid,
    metric="Accuracy",
    verbose=FALSE)
#
gbm.res

# Extract predictions for gradient boosting machine
confusionMatrix(predict(gbm.res, train, type="raw"), train$ds_program)
confusionMatrix(predict(gbm.res, test, type="raw"), test$ds_program)

# Variable importance for gradient boosting machine 
gbmImp <- varImp(gbm.res)
plot(gbmImp)
