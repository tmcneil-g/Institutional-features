# Logistic regression for presence of undergraduate data science major for R1 and R2 institutions

library(stats)
library(car)
library(dplyr)

# Read data
institutional_data <- read.csv(file = "data/institutional_r1r2.csv")

# Drop rows with missing data
institutional_data <- institutional_data %>%
  filter(access_earnings > 0)

# Drop rows with missing data again
institutional_data <- na.omit(institutional_data)

# Convert variables into categorical (factor) variables
institutional_data$type <- factor(institutional_data$type)
institutional_data$ds_program <- factor(institutional_data$ds_program, 
        labels=c("DS", "No_DS"))
institutional_data$public_private <- factor(institutional_data$public_private)
institutional_data$size <- factor(institutional_data$size, ordered = TRUE)
institutional_data$land_grant <- factor(institutional_data$land_grant)
institutional_data$access_earnings <- factor(institutional_data$access_earnings, 
                                      ordered = TRUE)

# Center and scale continuous independent variables
institutional_data$average_salary <- scale(institutional_data$average_salary, 
                                     center = TRUE, scale = TRUE)
institutional_data$fte_staff <- scale(institutional_data$fte_staff, 
                                center = TRUE, scale = TRUE)
institutional_data$endowment <- scale(institutional_data$endowment, 
                                center = TRUE, scale = TRUE)
institutional_data$core_expenses <- scale(institutional_data$core_expenses, 
                                    center = TRUE, scale = TRUE)
institutional_data$endowment_per_fte <- 
  scale(institutional_data$endowment_per_fte, 
  center = TRUE, scale = TRUE)
institutional_data$admitted <- scale(institutional_data$admitted, 
                               center = TRUE, scale = TRUE)
institutional_data$women <- scale(institutional_data$women, 
                            center = TRUE, scale = TRUE)
institutional_data$international <- scale(institutional_data$international, 
                                    center = TRUE, scale = TRUE)
institutional_data$white <- scale(institutional_data$white, 
                            center = TRUE, scale = TRUE)
institutional_data$hispanic <- scale(institutional_data$hispanic, 
                               center = TRUE, scale = TRUE)
institutional_data$black <- scale(institutional_data$black, 
                            center = TRUE, scale = TRUE)
institutional_data$asian <- scale(institutional_data$asian, 
                            center = TRUE, scale = TRUE)
institutional_data$undergrad_enrollment_ft <- 
  scale(institutional_data$undergrad_enrollment_ft, 
  center = TRUE, scale = TRUE)
institutional_data$graduation <- scale(institutional_data$graduation, 
                                 center = TRUE, scale = TRUE)
institutional_data$equity_ratio <- scale(institutional_data$equity_ratio, 
                                   center = TRUE, scale = TRUE)
institutional_data$retention <- scale(institutional_data$retention, 
                                   center = TRUE, scale = TRUE)
institutional_data$pell <- scale(institutional_data$pell, 
                                   center = TRUE, scale = TRUE)
institutional_data$awarded_aid <- scale(institutional_data$awarded_aid, 
                                   center = TRUE, scale = TRUE)
institutional_data$usnews_rank <- scale(institutional_data$usnews_rank, 
                                   center = TRUE, scale = TRUE)

# Run logistic regression
model_all <- glm(ds_program ~ type + usnews_rank + public_private + size + 
          land_grant + access_earnings + admitted + women + international + 
          hispanic + black + asian + white + undergrad_enrollment_ft + graduation +
          endowment_per_fte + equity_ratio + core_expenses + endowment + 
          fte_staff + average_salary + retention + pell + awarded_aid, 
          data = institutional_data, 
          family = binomial)

# Check VIF values
vif(model_all)

# Test whether categorical variables (with 3+ levels) are significant overall 
# Fit the reduced model (removes the categorical variable "type")
model_reduced <- glm(ds_program ~ usnews_rank + public_private + size + 
          land_grant + access_earnings + admitted + women + international + 
          hispanic + black + asian + white + undergrad_enrollment_ft + graduation +
          endowment_per_fte + equity_ratio + core_expenses + endowment + 
          fte_staff + average_salary + retention + pell + awarded_aid, 
          data = institutional_data, 
          family = binomial)

# Likelihood Ratio Test 
anova(model_reduced, model_all, test = "Chisq")

# Fit the reduced model (removes the categorical variable "size")
model_reduced <- glm(ds_program ~ type + usnews_rank + public_private + 
          land_grant + access_earnings + admitted + women + international + 
          hispanic + black + asian + white + undergrad_enrollment_ft + graduation +
          endowment_per_fte + equity_ratio + core_expenses + endowment + 
          fte_staff + average_salary + retention + pell + awarded_aid, 
          data = institutional_data, 
          family = binomial)

# Likelihood Ratio Test 
anova(model_reduced, model_all, test = "Chisq")

# Fit the reduced model (removes the categorical variable "access_earnings")
model_reduced <- glm(ds_program ~ type + usnews_rank + public_private + 
          land_grant + admitted + women + international + 
          hispanic + black + asian + white + undergrad_enrollment_ft + graduation +
          endowment_per_fte + equity_ratio + core_expenses + endowment + 
          fte_staff + average_salary + retention + pell + awarded_aid, 
          data = institutional_data, 
          family = binomial)

# Likelihood Ratio Test 
anova(model_reduced, model_all, test = "Chisq")
summary(model_all)
exp(coef(model_all))

# Get significance of the overall model
with(model_all, null.deviance - deviance)

# Get the degrees of freedom for the difference between the two models 
with(model_all, df.null - df.residual)

# Get p-value
with(model_all, pchisq(null.deviance - deviance, df.null - df.residual, lower.tail = FALSE))
