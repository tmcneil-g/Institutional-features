# Logistic regression for presence of undergraduate data science major
# for R1 and R2 institutions using U.S. News ranking

library(stats)
library(car)
library(dplyr)
library(pROC)
library(MuMIn)
library(emmeans)
library(broom)

# Read data
institutional_data <- read.csv(file = "data/institutional_data_r1r2_b.csv")

# Convert variables into categorical (factor) variables
institutional_data$ds_program <- factor(institutional_data$ds_program, 
                                        labels=c("DS", "No_DS"))
institutional_data$public_private <- factor(institutional_data$public_private)
institutional_data$barron_rank <- factor(institutional_data$barron_rank, 
                                         ordered = TRUE)

# Center and scale continuous independent variables
institutional_data$endowment <- scale(institutional_data$endowment, 
                                      center = TRUE, scale = TRUE)
institutional_data$admitted <- scale(institutional_data$admitted, 
                                     center = TRUE, scale = TRUE)
institutional_data$women <- scale(institutional_data$women, 
                                  center = TRUE, scale = TRUE)
institutional_data$international <- scale(institutional_data$international, 
                                          center = TRUE, scale = TRUE)
institutional_data$undergrad_enrollment_ft <- 
  scale(institutional_data$undergrad_enrollment_ft, 
        center = TRUE, scale = TRUE)
institutional_data$per_minority <- scale(institutional_data$per_minority, 
        center = TRUE, scale = TRUE)
institutional_data$fte_staff <- scale(institutional_data$fte_staff, 
                                       center = TRUE, scale = TRUE)
institutional_data$usnews_rank <- scale(institutional_data$usnews_rank, 
                                       center = TRUE, scale = TRUE)

# Run logistic regression
model_all <- glm(ds_program ~ undergrad_enrollment_ft + endowment + 
             per_minority + usnews_rank + public_private + admitted + 
             women + international + fte_staff, 
                 data = institutional_data, 
                 family = binomial)

# Extract Cook's Distance values
cooks_vals <- cooks.distance(model_all)

# Generates a bar chart of Cook's Distance values per observation
plot(model_all, which = 4)

# Check VIF values
vif(model_all)

# Get significance of the overall model
with(model_all, null.deviance - deviance)

# Get the degrees of freedom for the difference between the two models 
with(model_all, df.null - df.residual)

# Get p-value of overall model
with(model_all, pchisq(null.deviance - deviance, df.null - df.residual, 
  lower.tail = FALSE))

# Get the number of observations in model
nobs(model_all)

# Get results of model
summary(model_all)

# Get the exponentiated coefficients
exp(coef(model_all))

# Calculate AICc
AICc(model_all)

# Get predicted probabilities
pred_probs <- predict(model_all, type = "response")

# Compute ROC curve
roc_obj <- roc(institutional_data$ds_program, pred_probs)

# Get AUC
auc(roc_obj)

# Number of data science programs
table(institutional_data$ds_program)

# Refine and format the table 
clean_table <- tidy(model_all) %>%
  mutate(odds_ratio = exp(estimate)) %>%
  select(term, estimate, std.error, statistic, p.value, odds_ratio) %>%
  mutate(across(where(is.numeric), ~ round(., 2)))

print(clean_table)

View(clean_table)
